# Lightwell server-side keys. Copy this file to .env (git-ignored) and fill in what you have.
# Never commit .env or paste keys into chat. Restart the backend after editing it.
# Browser keys (Matterport SDK key, Google / Cesium, Mapillary) go in lightwell/config.js instead.

# Claude: the planning agent (deepagents) and backend/count_cars.py. From console.anthropic.com.
ANTHROPIC_API_KEY=

# Matterport Model API (GraphQL): backend/matterport.py measures floor plates from CoStar's scans.
# CoStar Discord card "Matterport GraphQL + SDK":  "API key" -> MATTERPORT_API_KEY,  "API token" -> MATTERPORT_API_TOKEN
# (Matterport's own names: API Token ID and API Token Secret.)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Vexcel aerial imagery: CoStar Discord card "Vexcel API", field "api_key". Kept for the Vexcel step (real-data/README.md).
VEXCEL_API_KEY=

# Optional: where the CoStar data kit folder is (holds index.md, data/, schemas/). Default: ../costar-hackathon-kit
# COSTAR_KIT_DIR=/path/to/costar-hackathon-kit

# Optional: another Claude model for the agent.
# LIGHTWELL_MODEL=anthropic:claude-opus-5-5
